# Copy these entries into .env and fill in only the NEW United States project.
# Never use a service_role key in an Expo app. Values here ship in the client.
EXPO_PUBLIC_US_SUPABASE_URL=
EXPO_PUBLIC_US_SUPABASE_PUBLISHABLE_KEY=
# Register a NEW Expo/EAS project before building or submitting.
US_EAS_PROJECT_ID=
# App IDs below are provisional; reserve the final IDs in the stores first.
US_IOS_BUNDLE_ID=com.dmvsmartprep.app
US_ANDROID_PACKAGE=com.dmvsmartprep.app

# Enable each provider only AFTER configuring Supabase Auth for the US project.
EXPO_PUBLIC_US_EMAIL_AUTH_ENABLED=false
EXPO_PUBLIC_US_GOOGLE_AUTH_ENABLED=false
EXPO_PUBLIC_US_APPLE_AUTH_ENABLED=false
# Apply the accounts/rankings SQL migration before enabling sync.
EXPO_PUBLIC_US_ACCOUNT_SYNC_ENABLED=false
EXPO_PUBLIC_US_SUPPORT_URL=
EXPO_PUBLIC_US_SUPPORT_EMAIL=
EXPO_PUBLIC_US_PRIVACY_URL=
EXPO_PUBLIC_US_TERMS_URL=
# Deploy supabase/functions/us-delete-account before enabling.
EXPO_PUBLIC_US_DELETE_ACCOUNT_ENABLED=false

# App Store Connect numeric app ID must match eas.json's US submit target.
US_ASC_APP_ID=

# RevenueCat PUBLIC platform SDK keys, not server/API secrets.
EXPO_PUBLIC_US_BILLING_ENABLED=false
EXPO_PUBLIC_US_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_US_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_US_PREMIUM_ENTITLEMENT=premium
EXPO_PUBLIC_US_MONTHLY_PRODUCT_ID=
EXPO_PUBLIC_US_LIFETIME_PRODUCT_ID=

# US AdMob records only. Always use test ads until sandbox/device checks pass.
EXPO_PUBLIC_US_ADS_ENABLED=false
EXPO_PUBLIC_US_ADS_TEST_MODE=true
EXPO_PUBLIC_US_ADMOB_IOS_APP_ID=
EXPO_PUBLIC_US_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_US_ADMOB_IOS_REWARDED_ID=
EXPO_PUBLIC_US_ADMOB_ANDROID_REWARDED_ID=
EXPO_PUBLIC_US_ADMOB_IOS_INTERSTITIAL_ID=
EXPO_PUBLIC_US_ADMOB_ANDROID_INTERSTITIAL_ID=
