# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local
.expo/
*.tsbuildinfo

# local question import payloads
data/import/*.json
!data/import/sample-exam.json

# generated native folders
/ios/*
!/ios/ci_scripts
/android
build.log
gorseller/
assets/*kopyas*

# Archived generated native projects still belong to the Turkish application.
/legacy/native-ios/
/legacy/native-android/

# Locally generated authentication secrets (never commit).
.secrets/

# Archived assets and code from the previous (Turkish) application: keep locally, never publish.
/AppStoreAssets/
/legacy/
scratch_test.js
